<div class="narrative-canvas-stage">
    {{#if isGM}}
        <div class="narrative-visibility-notice {{#if playerViewActive}}status-live{{else}}status-preparing{{/if}}" role="status" title="{{#if playerViewActive}}{{localize 'NARRATIVE_CANVAS.Status.LiveTooltip'}}{{else}}{{localize 'NARRATIVE_CANVAS.Status.PreparingTooltip'}}{{/if}}">
            <i class="fas {{#if playerViewActive}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
            <span class="visibility-status-label">
                {{#if playerViewActive}}{{localize "NARRATIVE_CANVAS.Status.Live"}}{{else}}{{localize "NARRATIVE_CANVAS.Status.Preparing"}}{{/if}}
            </span>
        </div>
    {{else}}
        <div class="narrative-player-toolbar" role="toolbar" aria-label="{{localize 'NARRATIVE_CANVAS.Player.AudioControls'}}">
            <div class="player-audio-mix-control">
                <label class="player-audio-volume-control" title="{{localize 'NARRATIVE_CANVAS.Player.AudioVolume'}}">
                    <i class="fas fa-volume-low" aria-hidden="true"></i>
                    <input type="range" class="player-audio-volume" min="0" max="1" step="0.05" value="{{playerAudioVolume}}" aria-label="{{localize 'NARRATIVE_CANVAS.Player.AudioVolume'}}" aria-valuetext="{{playerAudioVolumePercent}}%" />
                    <output class="player-audio-volume-percent">{{playerAudioVolumePercent}}%</output>
                </label>
                <button type="button" class="btn-player-audio-mute" data-muted="{{playerAudioMuted}}" title="{{#if playerAudioMuted}}{{localize 'NARRATIVE_CANVAS.Player.UnmuteAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Player.MuteAudio'}}{{/if}}" aria-label="{{#if playerAudioMuted}}{{localize 'NARRATIVE_CANVAS.Player.UnmuteAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Player.MuteAudio'}}{{/if}}">
                    <i class="fas {{#if playerAudioMuted}}fa-volume-xmark{{else}}fa-volume-high{{/if}}" aria-hidden="true"></i>
                </button>
            </div>
            <button type="button" class="btn-close-player-canvas" title="{{localize 'NARRATIVE_CANVAS.Controls.ClosePlayerCanvas'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Controls.ClosePlayerCanvas'}}">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </div>
    {{/if}}

    <!-- Ambient Background Crossfade Container -->
    <div class="narrative-bg-container">
        {{#if background}}
            <div class="narrative-bg-layer is-active" style="background-image: url('{{background}}');"></div>
        {{/if}}
    </div>

    {{#if backgroundDescription}}
        <div class="narrative-background-description">{{{backgroundDescription}}}</div>
    {{/if}}

    <div class="narrative-handout-image-layer">
        {{#each handoutImageOverlays}}
            <div class="narrative-handout-image-overlay" data-overlay-id="{{this.id}}" data-position-x="{{this.position.x}}" data-position-y="{{this.position.y}}" data-size="{{this.size}}">
                <div class="narrative-scene-handout-image-frame">
                    <img src="{{this.src}}" alt="{{this.title}}" class="narrative-scene-handout-image" draggable="false" />
                    {{#if this.description}}
                        <div class="narrative-scene-handout-image-description">{{{this.description}}}</div>
                    {{/if}}
                    {{#if ../isGM}}
                        <button type="button" class="btn-close-handout-image" data-overlay-id="{{this.id}}" title="{{localize 'NARRATIVE_CANVAS.Director.CloseImageOverlay'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.CloseImageOverlay'}}">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                        <button type="button" class="btn-resize-handout-image" data-overlay-id="{{this.id}}" title="{{localize 'NARRATIVE_CANVAS.Director.ResizeImageOverlay'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.ResizeImageOverlay'}}">
                            <i class="fas fa-expand-alt" aria-hidden="true"></i>
                        </button>
                    {{/if}}
                </div>
            </div>
        {{/each}}
    </div>
    
    <!-- Ambient Overlay Vignette -->
    <div class="narrative-overlay-vignette"></div>

    <!-- Visual Novel Character Overlays Layer -->
    <div class="narrative-visual-novel-stage {{#if hasActiveSpeaker}}has-speaker{{/if}}">
        {{#each activeActors}}
            <div class="narrative-vn-character {{#if this.isSpeaker}}is-speaker{{/if}}" id="nc-vn-{{this.id}}" data-actor-id="{{this.id}}">
                <div class="narrative-vn-image-wrapper">
                    <img src="{{this.img}}" alt="{{this.name}}" class="narrative-vn-image" />
                    {{#if this.showName}}
                        <div class="narrative-vn-name-plate">
                            <span class="narrative-vn-name-text">{{this.name}}</span>
                        </div>
                    {{/if}}
                </div>
            </div>
        {{/each}}
    </div>

    <!-- Handout Component Layer -->
    {{#if handout}}
    <div class="narrative-handout-container animate-fade-in">
        <img src="{{handout.src}}" alt="{{handout.title}}" class="narrative-handout-image"/>
        {{#if handout.title}}
            <h3 class="narrative-handout-title">{{handout.title}}</h3>
        {{/if}}
    </div>
    {{/if}}

    <!-- Dialogue Stage Component -->
    {{#if activeDialogue}}
    <div class="narrative-dialogue-stage animate-slide-up">
        {{#if activeDialogue.portrait}}
            <div class="narrative-speaker-portrait">
                <img src="{{activeDialogue.portrait}}" alt="{{activeDialogue.speaker}}"/>
            </div>
        {{/if}}
        
        <div class="narrative-speech-bubble">
            <h2 class="narrative-speaker-name">{{activeDialogue.speaker}}</h2>
            <p class="narrative-speech-text">{{activeDialogue.text}}</p>
        </div>
    </div>
    {{/if}}
</div>
