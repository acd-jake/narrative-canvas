<div class="narrative-canvas-stage">
    {{#if isGM}}
        <div class="narrative-visibility-notice {{#if playerViewActive}}status-live{{else}}status-preparing{{/if}}" role="status">
            <i class="fas {{#if playerViewActive}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
            <span class="visibility-status-label">
                {{#if playerViewActive}}{{localize "NARRATIVE_CANVAS.Status.Live"}}{{else}}{{localize "NARRATIVE_CANVAS.Status.Preparing"}}{{/if}}
            </span>
        </div>
    {{/if}}

    <!-- Ambient Background Crossfade Container -->
    <div class="narrative-bg-container">
        {{#if background}}
            <div class="narrative-bg-layer is-active" style="background-image: url('{{background}}');"></div>
        {{/if}}
    </div>

    {{#if backgroundDescription}}
        <div class="narrative-background-description">{{{backgroundDescription}}}</div>
    {{/if}}

    {{#each handoutImageOverlays}}
        <div class="narrative-handout-image-overlay" data-overlay-id="{{this.id}}" data-position-x="{{this.position.x}}" data-position-y="{{this.position.y}}">
            <div class="narrative-scene-handout-image-frame">
                <img src="{{this.src}}" alt="{{this.title}}" class="narrative-scene-handout-image" draggable="false" />
                {{#if this.description}}
                    <div class="narrative-scene-handout-image-description">{{{this.description}}}</div>
                {{/if}}
                {{#if ../isGM}}
                    <button type="button" class="btn-close-handout-image" data-overlay-id="{{this.id}}" title="{{localize 'NARRATIVE_CANVAS.Director.CloseImageOverlay'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.CloseImageOverlay'}}">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                {{/if}}
            </div>
        </div>
    {{/each}}
    
    <!-- Ambient Overlay Vignette -->
    <div class="narrative-overlay-vignette"></div>

    <!-- Visual Novel Character Overlays Layer -->
    <div class="narrative-visual-novel-stage {{#if hasActiveSpeaker}}has-speaker{{/if}}">
        {{#each activeActors}}
            <div class="narrative-vn-character {{#if this.isSpeaker}}is-speaker{{/if}}" id="nc-vn-{{this.id}}" data-actor-id="{{this.id}}">
                <div class="narrative-vn-image-wrapper">
                    <img src="{{this.img}}" alt="{{this.name}}" class="narrative-vn-image" />
                    {{#if this.showName}}
                        <div class="narrative-vn-name-plate">
                            <span class="narrative-vn-name-text">{{this.name}}</span>
                        </div>
                    {{/if}}
                </div>
            </div>
        {{/each}}
    </div>

    <!-- Handout Component Layer -->
    {{#if handout}}
    <div class="narrative-handout-container animate-fade-in">
        <img src="{{handout.src}}" alt="{{handout.title}}" class="narrative-handout-image"/>
        {{#if handout.title}}
            <h3 class="narrative-handout-title">{{handout.title}}</h3>
        {{/if}}
    </div>
    {{/if}}

    <!-- Dialogue Stage Component -->
    {{#if activeDialogue}}
    <div class="narrative-dialogue-stage animate-slide-up">
        {{#if activeDialogue.portrait}}
            <div class="narrative-speaker-portrait">
                <img src="{{activeDialogue.portrait}}" alt="{{activeDialogue.speaker}}"/>
            </div>
        {{/if}}
        
        <div class="narrative-speech-bubble">
            <h2 class="narrative-speaker-name">{{activeDialogue.speaker}}</h2>
            <p class="narrative-speech-text">{{activeDialogue.text}}</p>
        </div>
    </div>
    {{/if}}
</div>
