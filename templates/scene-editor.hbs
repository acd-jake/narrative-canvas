<div class="narrative-editor-window font-foundry" style="--nc-tile-size: {{tileSize}}px;">
    <div class="editor-main-content">
    <!-- Left Sidebar: Scene List Management (Independently Scrollable) -->
    <aside class="editor-scenes-sidebar">
        <header class="sidebar-action-header">
            <h3><i class="fas fa-cubes"></i> {{localize "NARRATIVE_CANVAS.Editor.Scenes"}}</h3>
            <button type="button" class="btn-create-scene button-primary type-icon" title="{{localize 'NARRATIVE_CANVAS.Editor.CreateScene'}}">
                <i class="fas fa-plus"></i>
            </button>
        </header>
        
        <!-- NEW CONTROL: Dynamic Persistent Size Slider -->
        <div class="sidebar-scale-controller">
            <label><i class="fas fa-th-large"></i> {{localize "NARRATIVE_CANVAS.Editor.TileSizeLabel"}}</label>
            <input type="range" class="slider-tile-scale" min="50" max="300" step="5" value="{{tileSize}}" />
        </div>

        <div class="scenes-navigation-list">
            {{#each allScenes}}
                <div class="scene-navigation-item {{#if (eq ../selectedSceneId this.id)}}is-selected{{/if}}" data-scene-id="{{this.id}}">
                    <div class="scene-nav-text">
                        <span class="scene-nav-name" title="{{this.name}}">{{this.name}}</span>
                        {{#if this.journalName}}
                            <span class="scene-nav-journal" title="{{this.journalName}}"><i class="fas fa-book-open"></i> {{this.journalName}}</span>
                        {{/if}}
                    </div>
                    <button type="button" class="btn-delete-scene type-icon" title="{{localize 'NARRATIVE_CANVAS.Editor.DeleteScene'}}">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            {{/each}}
        </div>
    </aside>

    <!-- Right Workspace: Selected Scene Details (Independently Scrollable) -->
    <main class="editor-workspace-details">
        {{#if activeScene}}
            <header class="editor-workspace-header">
                <div class="scene-title-edit-row">
                    <input type="text" class="input-scene-rename-field" value="{{activeScene.name}}" data-scene-id="{{activeScene.id}}" />
                </div>
                {{#if activeScene.journalName}}
                    <span class="journal-link-badge"><i class="fas fa-book-open"></i> {{activeScene.journalName}}</span>
                {{else}}
                    <span class="free-scene-badge"><i class="fas fa-globe"></i> {{localize "NARRATIVE_CANVAS.Editor.FreeScene"}}</span>
                {{/if}}
            </header>

            <div class="workspace-scroll-container">
                <!-- Section 1: Background Images -->
                <section class="workspace-section editor-dropzone" data-type="ImageCollection" data-image-collection="backgrounds" data-scene-id="{{activeScene.id}}">
                    <header class="section-component-header">
                        <h4><i class="fas fa-images"></i> {{localize "NARRATIVE_CANVAS.Labels.SceneBackgrounds"}}</h4>
                        <button type="button" class="btn-editor-add-image button-secondary" data-image-collection="backgrounds" data-scene-id="{{activeScene.id}}">
                            <i class="fas fa-plus"></i> {{localize "NARRATIVE_CANVAS.Editor.AddImage"}}
                        </button>
                    </header>
                    <div class="tiles-wrapping-grid image-collection-grid">
                        {{#each activeScene.backgrounds}}
                            <div class="tile-thumbnail-card background-tile-card" data-index="{{@index}}" data-type="SceneImage" data-image-collection="backgrounds" draggable="true">
                                <div class="tile-image-wrapper">
                                    <img src="{{this.path}}" alt="{{this.name}}" />
                                    <button type="button" class="btn-edit-background-description tile-overlay-toggle-name {{#if this.hasDescription}}is-active{{/if}}" aria-expanded="false" title="{{#if this.descriptionTooltip}}{{localize 'NARRATIVE_CANVAS.Editor.EditBackgroundDescription'}}: {{this.descriptionTooltip}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.AddBackgroundDescription'}}{{/if}}">
                                        <i class="fas {{#if this.hasDescription}}fa-comment-dots{{else}}fa-comment{{/if}}"></i>
                                    </button>
                                    <button type="button" class="btn-toggle-background-description-visibility {{#if this.showDescription}}is-active{{/if}}" title="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Editor.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.ShowBackgroundDescription'}}{{/if}}" aria-label="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Editor.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.ShowBackgroundDescription'}}{{/if}}">
                                        <i class="fas {{#if this.showDescription}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn-delete-item tile-overlay-delete"><i class="fas fa-times"></i></button>
                                </div>
                                <span class="tile-label-text">{{this.name}}</span>
                                <div class="background-description-popup" aria-hidden="true">
                                    <header>
                                        <span>{{localize "NARRATIVE_CANVAS.Editor.ImageDescription"}}</span>
                                        <button type="button" class="btn-close-background-description" title="{{localize 'NARRATIVE_CANVAS.Editor.CloseBackgroundDescription'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Editor.CloseBackgroundDescription'}}"><i class="fas fa-times"></i></button>
                                    </header>
                                    <prose-mirror class="background-description-editor" name="background-description" value="{{this.description}}" data-scene-id="{{../activeScene.id}}" data-image-collection="backgrounds" data-image-index="{{@index}}"></prose-mirror>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </section>

                <section class="workspace-section editor-dropzone" data-type="ImageCollection" data-image-collection="handoutImages" data-scene-id="{{activeScene.id}}">
                    <header class="section-component-header">
                        <h4><i class="fas fa-book-open"></i> {{localize "NARRATIVE_CANVAS.Labels.HandoutImages"}}</h4>
                        <button type="button" class="btn-editor-add-image button-secondary" data-image-collection="handoutImages" data-scene-id="{{activeScene.id}}">
                            <i class="fas fa-plus"></i> {{localize "NARRATIVE_CANVAS.Editor.AddImage"}}
                        </button>
                    </header>
                    <div class="tiles-wrapping-grid image-collection-grid">
                        {{#each activeScene.handoutImages}}
                            <div class="tile-thumbnail-card background-tile-card" data-index="{{@index}}" data-type="SceneImage" data-image-collection="handoutImages" draggable="true">
                                <div class="tile-image-wrapper">
                                    <img src="{{this.path}}" alt="{{this.name}}" />
                                    <button type="button" class="btn-edit-background-description tile-overlay-toggle-name {{#if this.hasDescription}}is-active{{/if}}" aria-expanded="false" title="{{#if this.descriptionTooltip}}{{localize 'NARRATIVE_CANVAS.Editor.EditBackgroundDescription'}}: {{this.descriptionTooltip}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.AddBackgroundDescription'}}{{/if}}">
                                        <i class="fas {{#if this.hasDescription}}fa-comment-dots{{else}}fa-comment{{/if}}"></i>
                                    </button>
                                    <button type="button" class="btn-toggle-background-description-visibility {{#if this.showDescription}}is-active{{/if}}" title="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Editor.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.ShowBackgroundDescription'}}{{/if}}" aria-label="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Editor.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.ShowBackgroundDescription'}}{{/if}}">
                                        <i class="fas {{#if this.showDescription}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn-delete-item tile-overlay-delete"><i class="fas fa-times"></i></button>
                                </div>
                                <span class="tile-label-text">{{this.name}}</span>
                                <div class="background-description-popup" aria-hidden="true">
                                    <header>
                                        <span>{{localize "NARRATIVE_CANVAS.Editor.ImageDescription"}}</span>
                                        <button type="button" class="btn-close-background-description" title="{{localize 'NARRATIVE_CANVAS.Editor.CloseBackgroundDescription'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Editor.CloseBackgroundDescription'}}"><i class="fas fa-times"></i></button>
                                    </header>
                                    <prose-mirror class="background-description-editor" name="handout-image-description" value="{{this.description}}" data-scene-id="{{../activeScene.id}}" data-image-collection="handoutImages" data-image-index="{{@index}}"></prose-mirror>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </section>

                <!-- Section 2: Actors -->
                <section class="workspace-section editor-dropzone" data-type="Actor" data-scene-id="{{activeScene.id}}">
                    <h4><i class="fas fa-users"></i> {{localize "NARRATIVE_CANVAS.Director.Actors"}}</h4>
                    <div class="tiles-wrapping-grid">
                        {{#each activeScene.actors}}
                            <div class="tile-thumbnail-card" data-id="{{this.id}}" data-type="Actor">
                                <div class="tile-image-wrapper">
                                    <img src="{{this.img}}" alt="{{this.name}}" />
                                    <button type="button" class="btn-toggle-actor-name tile-overlay-toggle-name {{#if (ne this.showName false)}}is-active{{/if}}" title="{{#if (ne this.showName false)}}{{localize 'NARRATIVE_CANVAS.Editor.HideActorName'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.ShowActorName'}}{{/if}}">
                                        <i class="fas {{#if (ne this.showName false)}}fa-id-badge{{else}}fa-eye-slash{{/if}}"></i>
                                    </button>
                                    <button type="button" class="btn-delete-item tile-overlay-delete"><i class="fas fa-times"></i></button>
                                </div>
                                <span class="tile-label-text">{{this.name}}</span>
                            </div>
                        {{/each}}
                        <div class="inline-drop-hint"><i class="fas fa-download"></i> {{localize "NARRATIVE_CANVAS.Editor.DropActorHint"}}</div>
                    </div>
                </section>

                <!-- Section 3: Audio Tracks -->
                <section class="workspace-section editor-dropzone" data-type="PlaylistSound" data-scene-id="{{activeScene.id}}">
                    <header class="section-component-header">
                        <h4><i class="fas fa-music"></i> {{localize "NARRATIVE_CANVAS.Director.Audio"}}</h4>
                        <button type="button" class="btn-editor-add-audio button-secondary" data-scene-id="{{activeScene.id}}">
                            <i class="fas fa-plus"></i> {{localize "NARRATIVE_CANVAS.Director.AddAudio"}}
                        </button>
                    </header>
                    <div class="audio-entry-list">
                        {{#each activeScene.audioEntries}}
                            <div class="tile-thumbnail-card audio-entry-badge audio-entry-badge--{{this.type}} {{#if this.isPreviewing}}is-previewing{{/if}}" data-id="{{this.id}}" data-type="{{this.repositoryType}}" data-audio-entry-id="{{this.entryId}}" data-audio-type="{{this.type}}" data-playlist-id="{{this.playlistId}}" data-audio-path="{{this.path}}">
                                <i class="fas {{#if (eq this.type 'playlist')}}fa-list-ul{{else}}fa-music{{/if}} audio-entry-type-icon" title="{{#if (eq this.type 'playlist')}}{{localize 'NARRATIVE_CANVAS.Editor.AudioPlaylist'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.AudioItem'}}{{/if}}" aria-label="{{#if (eq this.type 'playlist')}}{{localize 'NARRATIVE_CANVAS.Editor.AudioPlaylist'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.AudioItem'}}{{/if}}"></i>
                                <span class="audio-entry-name" title="{{this.name}}">{{this.name}}</span>
                                <button type="button" class="btn-audio-preview" data-audio-entry-id="{{this.entryId}}" title="{{#if this.isPreviewing}}{{localize 'NARRATIVE_CANVAS.Editor.StopAudioPreview'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.PreviewAudio'}}{{/if}}" aria-label="{{#if this.isPreviewing}}{{localize 'NARRATIVE_CANVAS.Editor.StopAudioPreview'}}{{else}}{{localize 'NARRATIVE_CANVAS.Editor.PreviewAudio'}}{{/if}}"><i class="fas {{#if this.isPreviewing}}fa-stop{{else}}fa-play{{/if}}" aria-hidden="true"></i></button>
                                <button type="button" class="btn-delete-item btn-delete-audio-entry" title="{{localize 'NARRATIVE_CANVAS.Editor.RemoveAudio'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Editor.RemoveAudio'}}"><i class="fas fa-times" aria-hidden="true"></i></button>
                            </div>
                        {{else}}
                            <div class="inline-drop-hint"><i class="fas fa-download"></i> {{localize "NARRATIVE_CANVAS.Editor.DropAudioHint"}}</div>
                        {{/each}}
                    </div>
                </section>
            </div>
        {{else}}
            <div class="workspace-empty-state editor-dropzone" data-type="*" data-scene-id="">
                <i class="fas fa-cubes"></i>
                <p>{{localize "NARRATIVE_CANVAS.Editor.NoSceneSelected"}}</p>
                <p class="empty-state-drop-hint"><i class="fas fa-download"></i> {{localize "NARRATIVE_CANVAS.Editor.DropToCreateHint"}}</p>
            </div>
        {{/if}}
    </main>
    </div>

    {{#if isJournalDocked}}
        <section class="journal-asset-shelf" aria-label="{{localize 'NARRATIVE_CANVAS.Editor.JournalAssets'}}">
            <h3>{{localize "NARRATIVE_CANVAS.Editor.JournalAssets"}}</h3>
            <div class="journal-asset-groups">
                <div class="journal-asset-group">
                    <h4>{{localize "NARRATIVE_CANVAS.Editor.JournalActors"}}</h4>
                    <div class="journal-asset-list">
                        {{#each journalAssets.actors}}
                            <div class="journal-asset-item" draggable="true" data-asset-type="Actor" data-asset-uuid="{{this.uuid}}" title="{{this.name}}">
                                <img src="{{this.img}}" alt="{{this.name}}" />
                                <span>{{this.name}}</span>
                            </div>
                        {{else}}
                            <span class="journal-asset-empty">{{localize "NARRATIVE_CANVAS.Editor.NoJournalAssets"}}</span>
                        {{/each}}
                    </div>
                </div>
                <div class="journal-asset-group">
                    <h4>{{localize "NARRATIVE_CANVAS.Editor.JournalImages"}}</h4>
                    <div class="journal-asset-list">
                        {{#each journalAssets.images}}
                            <div class="journal-asset-item" draggable="true" data-asset-type="Image" data-asset-path="{{this.path}}" data-asset-name="{{this.name}}" title="{{this.name}}">
                                <img src="{{this.path}}" alt="{{this.name}}" />
                                <span>{{this.name}}</span>
                            </div>
                        {{else}}
                            <span class="journal-asset-empty">{{localize "NARRATIVE_CANVAS.Editor.NoJournalAssets"}}</span>
                        {{/each}}
                    </div>
                </div>
            </div>
        </section>
    {{/if}}
</div>
