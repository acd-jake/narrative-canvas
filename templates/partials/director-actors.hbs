<div class="narrative-director-actors-bar font-foundry">
    <div class="actor-carousel-corner-actions">
        <div class="actor-carousel-corner-group">
            <button type="button" class="btn-carousel-action btn-carousel-toggle-player-visibility {{#if isVisualNovelOverlayVisible}}is-active{{/if}}" aria-pressed="{{isVisualNovelOverlayVisible}}" title="{{#if isVisualNovelOverlayVisible}}{{localize 'NARRATIVE_CANVAS.Director.HideVisualNovelFromPlayers'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ShowVisualNovelToPlayers'}}{{/if}}" aria-label="{{#if isVisualNovelOverlayVisible}}{{localize 'NARRATIVE_CANVAS.Director.HideVisualNovelFromPlayers'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ShowVisualNovelToPlayers'}}{{/if}}">
                <i class="fas {{#if isVisualNovelOverlayVisible}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn-carousel-action btn-carousel-clear-stage" {{#unless hasActiveActors}}disabled{{/unless}} title="{{localize 'NARRATIVE_CANVAS.Director.ClearActorStage'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.ClearActorStage'}}">
                <i class="fas fa-users-slash" aria-hidden="true"></i>
            </button>
        </div>
        <details class="director-layout-picker actor-layout-picker {{#if isActorLayoutTemporary}}is-temporary{{/if}}">
            <summary class="btn-carousel-action layout-picker-toggle" title="{{localize 'NARRATIVE_CANVAS.Director.ActorLayout'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.ActorLayout'}}">
                <i class="fas fa-users-gear" aria-hidden="true"></i>
            </summary>
            <div class="layout-picker-menu" role="group" aria-label="{{localize 'NARRATIVE_CANVAS.Director.ActorLayout'}}">
                <button type="button" class="layout-picker-option {{#unless isActorLayoutTemporary}}is-selected{{/unless}}" data-actor-layout="" aria-pressed="{{#unless isActorLayoutTemporary}}true{{else}}false{{/unless}}" title="{{localize 'NARRATIVE_CANVAS.Director.LayoutUseModuleSetting'}}">
                    <span>{{localize "NARRATIVE_CANVAS.Director.LayoutUseModuleSetting"}}</span>
                    <i class="fas fa-check layout-picker-check" aria-hidden="true" {{#if isActorLayoutTemporary}}hidden{{/if}}></i>
                </button>
                {{#each actorLayoutChoices}}
                    <button type="button" class="layout-picker-option {{#if this.selected}}is-selected{{/if}}" data-actor-layout="{{this.id}}" aria-pressed="{{this.selected}}" title="{{this.hint}}">
                        <span>{{localize this.labelKey}}</span>
                        <i class="fas fa-check layout-picker-check" aria-hidden="true" {{#unless this.selected}}hidden{{/unless}}></i>
                    </button>
                {{/each}}
                <div class="layout-picker-divider">{{localize "NARRATIVE_CANVAS.Settings.ActorDialoguePositionModeLabel"}}</div>
                <button type="button" class="layout-picker-option {{#unless isActorDialoguePositionModeTemporary}}is-selected{{/unless}}" data-actor-dialogue-position="" aria-pressed="{{#unless isActorDialoguePositionModeTemporary}}true{{else}}false{{/unless}}" title="{{localize 'NARRATIVE_CANVAS.Director.LayoutUseModuleSetting'}}">
                    <span>{{localize "NARRATIVE_CANVAS.Director.LayoutUseModuleSetting"}}</span>
                    <i class="fas fa-check layout-picker-check" aria-hidden="true" {{#if isActorDialoguePositionModeTemporary}}hidden{{/if}}></i>
                </button>
                {{#each actorDialoguePositionChoices}}
                    <button type="button" class="layout-picker-option {{#if this.selected}}is-selected{{/if}}" data-actor-dialogue-position="{{this.id}}" aria-pressed="{{this.selected}}" title="{{this.hint}}">
                        <span>{{localize this.labelKey}}</span>
                        <i class="fas fa-check layout-picker-check" aria-hidden="true" {{#unless this.selected}}hidden{{/unless}}></i>
                    </button>
                {{/each}}
            </div>
        </details>
    </div>

    <div class="carousel-nav-control">
        <button type="button" class="btn-carousel-scroll btn-carousel-scroll-left" title="{{localize 'NARRATIVE_CANVAS.Director.ScrollLeft'}}">
            <i class="fas fa-chevron-left"></i>
        </button>
    </div>

    <div class="actors-carousel-track">
        {{#each actors}}
            <div class="actor-carousel-card {{#if this.isOnStage}}is-on-stage{{/if}} {{#if this.isSpeaker}}is-active-speaker{{/if}}" data-actor-id="{{this.id}}" title="{{this.name}}">
                <div class="actor-card-thumbnail-box">
                    <img src="{{this.img}}" alt="{{this.name}}" class="actor-card-thumb" />
                    
                    <!-- Top Overlay: Speaker & Name visibility controls -->
                    <div class="actor-card-overlay-actions">
                        <!-- Toggle Active Speaker -->
                        <button type="button" class="btn-carousel-action btn-carousel-toggle-speaker {{#if this.isSpeaker}}is-active{{/if}}" title="{{#if this.isSpeaker}}{{localize 'NARRATIVE_CANVAS.Director.RemoveSpeaker'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.SetSpeaker'}}{{/if}}">
                            <i class="fas fa-comment-dots"></i>
                        </button>

                        <!-- Toggle Name Visibility -->
                        <button type="button" class="btn-carousel-action btn-carousel-toggle-name {{#if this.showName}}is-active{{/if}}" title="{{#if this.showName}}{{localize 'NARRATIVE_CANVAS.Director.HideName'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ShowName'}}{{/if}}">
                            <i class="fas {{#if this.showName}}fa-id-badge{{else}}fa-eye-slash{{/if}}"></i>
                        </button>
                    </div>

                    <!-- Remove from Stage Overlay Button -->
                    {{#if this.isOnStage}}
                        <button type="button" class="btn-carousel-action btn-carousel-remove-stage" title="{{localize 'NARRATIVE_CANVAS.Director.RemoveFromStage'}}">
                            <i class="fas fa-times"></i>
                        </button>
                    {{/if}}
                </div>
                
                <span class="actor-card-name" title="{{this.name}}">{{this.name}}</span>
            </div>
        {{/each}}
    </div>

    <div class="carousel-nav-control">
        <button type="button" class="btn-carousel-scroll btn-carousel-scroll-right" title="{{localize 'NARRATIVE_CANVAS.Director.ScrollRight'}}">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    <form class="director-dialogue-controls" {{#unless dialogueSystemEnabled}}hidden{{/unless}} autocomplete="off">
        <select class="dialogue-speaker" title="{{localize 'NARRATIVE_CANVAS.Dialogue.Speaker'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Dialogue.Speaker'}}">
            <option value="" {{#unless dialogueSpeakerId}}selected{{/unless}}>{{localize 'NARRATIVE_CANVAS.Dialogue.Narrator'}}</option>
            {{#each actors}}
                <option value="{{this.id}}" {{#if this.isDialogueSpeaker}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
        </select>
        {{#if hasTalkingActors}}
            <button type="button" class="dialogue-voice-toggle {{#if dialogueVoice}}is-active{{/if}}" aria-pressed="{{#if dialogueVoice}}true{{else}}false{{/if}}" title="{{localize 'NARRATIVE_CANVAS.Dialogue.Voice'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Dialogue.Voice'}}">
                <i class="fas fa-microphone" aria-hidden="true"></i>
            </button>
        {{/if}}
        {{#if dialogueLanguages}}
            <select class="dialogue-language" title="{{localize 'NARRATIVE_CANVAS.Dialogue.Language'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Dialogue.Language'}}">
                {{#each dialogueLanguages}}
                    <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
            </select>
        {{/if}}
        <textarea class="dialogue-text" rows="1" placeholder="{{localize 'NARRATIVE_CANVAS.Dialogue.TextPlaceholder'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Dialogue.TextPlaceholder'}}"></textarea>
        <button type="submit" class="dialogue-send" title="{{localize 'NARRATIVE_CANVAS.Dialogue.Send'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Dialogue.Send'}}">
            <i class="fas fa-paper-plane" aria-hidden="true"></i>
        </button>
        <label class="dialogue-speed" title="{{localize 'NARRATIVE_CANVAS.Dialogue.Speed'}}">
            <i class="fas fa-gauge-high" aria-hidden="true"></i>
            <input type="range" class="dialogue-speed-slider" min="0" max="100" step="1" value="{{dialogueSpeedSlider}}" aria-label="{{localize 'NARRATIVE_CANVAS.Dialogue.Speed'}}" />
            <output class="dialogue-speed-value">{{dialogueSpeedLabel}}</output>
        </label>
    </form>
</div>
