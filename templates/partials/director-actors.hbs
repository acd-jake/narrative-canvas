<div class="narrative-director-actors-bar font-foundry">
    <header class="bar-header"><i class="fas fa-users"></i> <h3>{{localize "NARRATIVE_CANVAS.Director.Actors"}}</h3></header>
    <div class="actors-horizontal-list">
        {{#each currentSceneData.actors}}
            <div class="actor-card {{#if this.isActiveOnCanvas}}is-active-on-stage{{/if}}" data-actor-id="{{this.id}}">
                <img src="{{this.img}}" alt="{{this.name}}" class="actor-card-thumb" />
                <span class="actor-card-name">{{this.name}}</span>
            </div>
        {{/each}}
    </div>
</div>
