<div class="narrative-director-panel font-foundry">
    <header class="director-panel-header">
        <i class="fas fa-film"></i> 
        <h3>{{localize "NARRATIVE_CANVAS.DirectorTitle"}}</h3>
        <span class="nc-status-badge {{#if playerViewActive}}status-live{{else}}status-preparing{{/if}}">
            {{#if playerViewActive}}{{localize "NARRATIVE_CANVAS.Status.Live"}}{{else}}{{localize "NARRATIVE_CANVAS.Status.Preparing"}}{{/if}}
        </span>
    </header>

    <!-- Active Scene Display & Sidebar Toggle -->
    <section class="director-control-group active-scene-group">
        <legend><i class="fas fa-folder-open"></i> {{localize "NARRATIVE_CANVAS.Labels.ActiveScene"}}</legend>
        <div class="active-scene-row">
            <div class="active-scene-display">
                <i class="fas fa-film"></i>
                {{#if currentSceneData}}
                    <span class="active-scene-name" title="{{currentSceneData.name}}">{{currentSceneData.name}}</span>
                {{else}}
                    <span class="active-scene-empty">-- {{localize "NARRATIVE_CANVAS.Placeholders.ChooseScene"}} --</span>
                {{/if}}
            </div>
            <button type="button" class="btn-toggle-sidebar button-secondary" title="{{localize 'NARRATIVE_CANVAS.Director.ToggleSidebar'}}">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </section>

    <!-- Scene image lists -->
    {{#if currentSceneData}}
    <section class="director-control-group">
        <legend><i class="fas fa-images"></i> {{localize "NARRATIVE_CANVAS.Labels.SceneBackgrounds"}}</legend>
        <div class="director-bg-grid">
            {{#each currentSceneData.backgrounds}}
                <div class="bg-thumbnail-card {{#if (eq ../selectedBackground this.path)}}is-active-bg{{/if}}" data-bg-path="{{this.path}}" data-background-index="{{@index}}">
                    <img src="{{this.path}}" alt="{{this.name}}" />
                    <div class="bg-thumbnail-actions">
                        <button type="button" class="btn-toggle-image-description {{#if this.showDescription}}is-active{{/if}}" data-image-collection="backgrounds" data-image-index="{{@index}}" title="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Director.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ShowBackgroundDescription'}}{{/if}}" aria-label="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Director.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ShowBackgroundDescription'}}{{/if}}">
                            <i class="fas {{#if this.showDescription}}fa-closed-captioning{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span class="bg-thumb-label">{{this.name}}</span>
                </div>
            {{/each}}
        </div>
    </section>
    <section class="director-control-group">
        <legend><i class="fas fa-book-open"></i> {{localize "NARRATIVE_CANVAS.Labels.HandoutImages"}}</legend>
        <div class="director-bg-grid">
            {{#each currentSceneData.handoutImages}}
                <div class="handout-thumbnail-card {{#if (eq ../handoutImage this.path)}}is-active-bg{{/if}}" data-handout-image-path="{{this.path}}">
                    <img src="{{this.path}}" alt="{{this.name}}" />
                    <div class="bg-thumbnail-actions">
                        <button type="button" class="btn-toggle-image-description {{#if this.showDescription}}is-active{{/if}}" data-image-collection="handoutImages" data-image-index="{{@index}}" title="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Director.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ShowBackgroundDescription'}}{{/if}}" aria-label="{{#if this.showDescription}}{{localize 'NARRATIVE_CANVAS.Director.HideBackgroundDescription'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ShowBackgroundDescription'}}{{/if}}">
                            <i class="fas {{#if this.showDescription}}fa-closed-captioning{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span class="bg-thumb-label">{{this.name}}</span>
                </div>
            {{/each}}
        </div>
    </section>
    {{/if}}

    <!-- Existing Player Visibility, Dialog Elements, and Footers Stay Intact below... -->
    <section class="director-control-group">
        <legend><i class="fas fa-eye"></i> {{localize "NARRATIVE_CANVAS.Labels.PlayerVisibility"}}</legend>
        <div class="director-input-row">
            {{#if playerViewActive}}
                <button type="button" class="btn-hide-players button-secondary"><i class="fas fa-eye-slash"></i> {{localize "NARRATIVE_CANVAS.Labels.HideCanvas"}}</button>
            {{else}}
                <button type="button" class="btn-publish-players button-primary"><i class="fas fa-broadcast-tower"></i> {{localize "NARRATIVE_CANVAS.Labels.PublishCanvas"}}</button>
            {{/if}}
        </div>
    </section>

    <footer class="director-panel-footer director-input-column">
        <button type="button" class="btn-clear-display button-secondary"><i class="fas fa-eraser"></i> {{localize "NARRATIVE_CANVAS.Labels.ClearAll"}}</button>
        <button type="button" class="btn-shutdown-canvas button-destructive"><i class="fas fa-power-off"></i> {{localize "NARRATIVE_CANVAS.Labels.ShutdownCanvas"}}</button>
    </footer>
</div>
