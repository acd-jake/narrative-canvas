<aside class="narrative-director-sidebar font-foundry {{#if isCollapsed}}is-collapsed{{/if}}">
    <!-- Collapse / Expand edge handle -->
    <button type="button" class="sidebar-collapse-toggle" title="{{#if isCollapsed}}{{localize 'NARRATIVE_CANVAS.Director.ExpandSidebar'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.CollapseSidebar'}}{{/if}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.ToggleSidebar'}}">
        <i class="fas {{#if isCollapsed}}fa-chevron-right{{else}}fa-chevron-left{{/if}}"></i>
    </button>

    <!-- Compact Section: Filterable Scenes List -->
    <section class="sidebar-scenes-section {{#if isScenesCollapsed}}is-collapsed{{/if}}">
        <header class="sidebar-section-header">
            <h4><i class="fas fa-cubes"></i> {{localize "NARRATIVE_CANVAS.Editor.Scenes"}}</h4>
            <span class="sidebar-active-scene-name {{#unless activeSceneId}}is-empty{{/unless}}" title="{{currentSceneName}}">{{currentSceneName}}</span>
            <button type="button" class="btn-clear-active-scene" title="{{localize 'NARRATIVE_CANVAS.Director.DeactivateActiveScene'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.DeactivateActiveScene'}}" {{#unless activeSceneId}}hidden{{/unless}}>
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
            <button type="button" class="sidebar-section-toggle" data-section-toggle="scenes" aria-expanded="{{#unless isScenesCollapsed}}true{{else}}false{{/unless}}" aria-controls="director-scenes-content" title="{{#if isScenesCollapsed}}{{localize 'NARRATIVE_CANVAS.Director.ExpandScenes'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.CollapseScenes'}}{{/if}}" aria-label="{{#if isScenesCollapsed}}{{localize 'NARRATIVE_CANVAS.Director.ExpandScenes'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.CollapseScenes'}}{{/if}}">
                <i class="fas {{#if isScenesCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
            </button>
        </header>
        <div class="sidebar-section-content" id="director-scenes-content">
            <div class="sidebar-search-row scenes-filter-row">
                <div class="scenes-search-wrapper">
                    <i class="fas fa-search search-icon"></i>
                    <input type="search" class="input-scenes-filter" placeholder="{{localize 'NARRATIVE_CANVAS.Director.FilterScenes'}}" value="{{sceneQuery}}" />
                </div>
                <label class="scenes-journal-filter-toggle" title="{{localize 'NARRATIVE_CANVAS.Director.FilterByJournalHint'}}">
                    <input type="checkbox" class="input-filter-by-journal" {{#if filterByJournal}}checked{{/if}} />
                    <span class="journal-filter-icon"><i class="fas fa-book"></i></span>
                    <span class="journal-filter-label">{{localize "NARRATIVE_CANVAS.Director.JournalOnly"}}</span>
                </label>
            </div>
            <label class="scenes-auto-activate-toggle" title="{{localize 'NARRATIVE_CANVAS.Director.AutoActivateFirstSceneHint'}}">
                <input type="checkbox" class="input-auto-activate-first-scene" {{#if autoActivateFirstSceneOnJournalChange}}checked{{/if}} />
                <span>{{localize "NARRATIVE_CANVAS.Director.AutoActivateFirstScene"}}</span>
            </label>
            <div class="director-scenes-list">
                {{#each scenes}}
                    <div class="director-scene-item {{#if (eq ../activeSceneId this.id)}}is-active{{/if}}" data-scene-id="{{this.id}}" data-journal-id="{{this.journalId}}">
                        <span class="scene-item-name" title="{{this.name}}">
                            <i class="fas fa-film"></i> {{this.name}}
                        </span>
                        {{#if this.journalName}}
                            <span class="scene-item-journal" title="{{this.journalName}}">
                                <i class="fas fa-book-open"></i> {{this.journalName}}
                            </span>
                        {{/if}}
                    </div>
                {{else}}
                    <div class="sidebar-empty-hint">{{localize "NARRATIVE_CANVAS.Director.NoScenes"}}</div>
                {{/each}}
            </div>
        </div>
    </section>

    <!-- Primary Section: Journal Viewer -->
    <section class="sidebar-journal-section">
        <header class="sidebar-section-header">
            <h4><i class="fas fa-book-open"></i> {{localize "NARRATIVE_CANVAS.Director.JournalViewer"}}</h4>
            <button type="button" class="btn-journal-back type-icon" title="{{localize 'NARRATIVE_CANVAS.Director.BackToPreviousDocument'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.BackToPreviousDocument'}}" {{#unless canGoBack}}hidden{{/unless}}>
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </button>
        </header>

        <!-- Journal Text Filter -->
        <div class="sidebar-search-row">
            <i class="fas fa-search search-icon"></i>
            <input type="search" class="input-journal-filter" placeholder="{{localize 'NARRATIVE_CANVAS.Director.FilterJournals'}}" value="{{journalQuery}}" />
        </div>

        <div class="journal-folder-navigation">
            <button type="button" class="btn-journal-folder-up type-icon" title="{{localize 'NARRATIVE_CANVAS.Director.NavigateToParentFolder'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.NavigateToParentFolder'}}" {{#unless canNavigateUp}}disabled{{/unless}}>
                <i class="fas fa-arrow-up" aria-hidden="true"></i>
            </button>
            <span class="journal-current-folder" title="{{currentJournalFolderLabel}}">{{currentJournalFolderLabel}}</span>
        </div>

        <!-- Concrete Journal Selection -->
        <div class="journal-control-row">
            <select class="select-journal-entry">
                <option value="">{{localize "NARRATIVE_CANVAS.Director.SelectJournalOrFolder"}}</option>
                {{#if childFolders.length}}
                    <optgroup label="{{localize 'NARRATIVE_CANVAS.Director.Subfolders'}}">
                        {{#each childFolders}}
                            <option value="folder:{{this.id}}">{{this.name}}</option>
                        {{/each}}
                    </optgroup>
                {{/if}}
                {{#each availableJournals}}
                    {{#if @first}}<optgroup label="{{localize 'NARRATIVE_CANVAS.Director.Journals'}}">{{/if}}
                    <option value="journal:{{this.id}}" {{#if (eq ../selectedJournalId this.id)}}selected{{/if}}>{{this.name}}</option>
                    {{#if @last}}</optgroup>{{/if}}
                {{/each}}
                {{#if linkedJournalOption}}
                    {{#unless availableJournals.length}}
                        <optgroup label="{{localize 'NARRATIVE_CANVAS.Director.Journals'}}">
                    {{/unless}}
                    <option value="journal:{{linkedJournalOption.id}}" data-linked-journal="true" selected>{{linkedJournalOption.name}}</option>
                    {{#unless availableJournals.length}}</optgroup>{{/unless}}
                {{/if}}
            </select>
        </div>

        <!-- Journal Contents & Horizontal Page Badges -->
        <div class="journal-viewer-body">
            {{#if activeJournal}}
                {{#if activeJournal.pages.length}}
                    <div class="journal-toc-carousel">
                        <button type="button" class="btn-toc-scroll btn-toc-prev" title="&lt;">
                            <i class="fas fa-chevron-left"></i>
                        </button>
                        <div class="journal-toc-track">
                            {{#each activeJournal.pages}}
                                <button type="button" class="journal-toc-badge {{#if (eq ../selectedPageId this.id)}}is-active{{/if}}" data-page-id="{{this.id}}" title="{{this.name}}">
                                    {{this.name}}
                                </button>
                            {{/each}}
                        </div>
                        <button type="button" class="btn-toc-scroll btn-toc-next" title="&gt;">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>

                    <div class="journal-viewer-content">
                        {{#if activePage}}
                            <h3 class="journal-page-title">{{activePage.name}}</h3>
                            <div class="journal-page-body">{{{activePage.content}}}</div>
                        {{/if}}
                    </div>
                {{else}}
                    <div class="sidebar-empty-hint">{{localize "NARRATIVE_CANVAS.Director.NoPages"}}</div>
                {{/if}}
            {{else}}
                <div class="journal-viewer-placeholder">
                    <i class="fas fa-book-reader"></i>
                    <p>{{localize "NARRATIVE_CANVAS.Director.NoJournalSelected"}}</p>
                </div>
            {{/if}}
        </div>
    </section>

    <!-- Compact Section: Scene Audio Elements & Volume Controls -->
    <section class="sidebar-audio-section {{#if isAudioCollapsed}}is-collapsed{{/if}} {{#if audioMuted}}is-muted{{/if}}">
        <header class="sidebar-section-header">
            <h4><i class="fas fa-music"></i> {{localize "NARRATIVE_CANVAS.Director.Audio"}}</h4>
            <button type="button" class="sidebar-section-toggle" data-section-toggle="audio" aria-expanded="{{#unless isAudioCollapsed}}true{{else}}false{{/unless}}" aria-controls="director-audio-content" title="{{#if isAudioCollapsed}}{{localize 'NARRATIVE_CANVAS.Director.ExpandAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.CollapseAudio'}}{{/if}}" aria-label="{{#if isAudioCollapsed}}{{localize 'NARRATIVE_CANVAS.Director.ExpandAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.CollapseAudio'}}{{/if}}">
                <i class="fas {{#if isAudioCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
            </button>
        </header>

        <div class="sidebar-section-content" id="director-audio-content">
            <div class="director-audio-tracks-list">
                {{#each activeSceneTracks}}
                    <div class="director-audio-track-item {{#if (eq this.playState 'playing')}}is-playing{{/if}} {{#if (eq this.playState 'paused')}}is-paused{{/if}}" data-track-id="{{this.id}}" data-track-path="{{this.path}}" data-track-name="{{this.name}}">
                        <div class="audio-track-info">
                            <span class="audio-track-name" title="{{this.name}}">
                                <i class="fas fa-volume-up track-status-icon"></i> {{this.name}}
                            </span>
                            <div class="audio-track-actions">
                                <button type="button" class="btn-track-toggle type-icon" title="{{#if (eq this.playState 'playing')}}{{localize 'NARRATIVE_CANVAS.Director.Pause'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.Play'}}{{/if}}">
                                    {{#if (eq this.playState 'playing')}}
                                        <i class="fas fa-pause"></i>
                                    {{else}}
                                        <i class="fas fa-play"></i>
                                    {{/if}}
                                </button>
                                <button type="button" class="btn-track-stop type-icon" title="{{localize 'NARRATIVE_CANVAS.Director.Stop'}}">
                                    <i class="fas fa-stop"></i>
                                </button>
                            </div>
                        </div>

                        <div class="audio-track-volume-row">
                            <i class="fas fa-volume-down volume-icon"></i>
                            <input type="range" class="slider-track-volume" min="0" max="1" step="0.05" value="{{this.volume}}" title="{{localize 'NARRATIVE_CANVAS.Director.TrackVolume'}}" />
                            <span class="volume-val-display">{{this.volumePercent}}%</span>
                        </div>
                    </div>
                {{else}}
                    <div class="sidebar-empty-hint">{{localize "NARRATIVE_CANVAS.Director.NoAudioTracks"}}</div>
                {{/each}}
            </div>

            <div class="audio-master-volume-box">
                <label class="master-volume-label">
                    <i class="fas fa-sliders-h"></i> {{localize "NARRATIVE_CANVAS.Director.MasterVolume"}}
                </label>
                <div class="master-volume-control">
                    <i class="fas fa-volume-off"></i>
                    <input type="range" class="slider-master-volume" min="0" max="1" step="0.05" value="{{globalVolume}}" />
                    <i class="fas fa-volume-up"></i>
                    <span class="master-volume-percent">{{masterVolumePercent}}%</span>
                </div>
            </div>
        </div>
    </section>
</aside>
