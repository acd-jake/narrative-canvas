<div class="narrative-canvas-toolbar" role="toolbar" aria-label="{{localize 'NARRATIVE_CANVAS.Director.CanvasActions'}}">
    {{#if playerViewActive}}
        <button type="button" data-canvas-action="hide" title="{{localize 'NARRATIVE_CANVAS.Labels.HideCanvas'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.HideCanvas'}}">
            <i class="fas fa-eye-slash" aria-hidden="true"></i>
        </button>
    {{else}}
        <button type="button" data-canvas-action="publish" title="{{localize 'NARRATIVE_CANVAS.Labels.PublishCanvas'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.PublishCanvas'}}">
            <i class="fas fa-broadcast-tower" aria-hidden="true"></i>
        </button>
    {{/if}}
    <button type="button" data-canvas-action="stop-audio" title="{{localize 'NARRATIVE_CANVAS.Director.StopAllAudio'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.StopAllAudio'}}">
        <i class="fas fa-volume-mute" aria-hidden="true"></i>
    </button>
    <button type="button" data-canvas-action="close-handouts" title="{{localize 'NARRATIVE_CANVAS.Labels.CloseAllHandouts'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.CloseAllHandouts'}}">
        <span class="toolbar-composite-icon" aria-hidden="true">
            <i class="fas fa-images"></i>
            <i class="fas fa-times"></i>
        </span>
    </button>
    <button type="button" data-canvas-action="reset-background" title="{{localize 'NARRATIVE_CANVAS.Labels.ResetBackground'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.ResetBackground'}}">
        <i class="fas fa-eraser" aria-hidden="true"></i>
    </button>
    <button type="button" class="is-destructive" data-canvas-action="shutdown" title="{{localize 'NARRATIVE_CANVAS.Labels.ShutdownCanvas'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.ShutdownCanvas'}}">
        <i class="fas fa-power-off" aria-hidden="true"></i>
    </button>
</div>