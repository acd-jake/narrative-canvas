<div class="narrative-canvas-toolbar" role="toolbar" aria-label="{{localize 'NARRATIVE_CANVAS.Director.CanvasActions'}}">
    {{#if playerViewActive}}
        <button type="button" data-canvas-action="hide" title="{{localize 'NARRATIVE_CANVAS.Labels.HideCanvas'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.HideCanvas'}}">
            <i class="fas fa-eye-slash" aria-hidden="true"></i>
        </button>
        <button type="button" data-canvas-action="reopen-players" title="{{localize 'NARRATIVE_CANVAS.Director.ReopenPlayerCanvases'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.ReopenPlayerCanvases'}}">
            <i class="fas fa-eye" aria-hidden="true"></i>
        </button>
    {{else}}
        <button type="button" data-canvas-action="publish" title="{{localize 'NARRATIVE_CANVAS.Labels.PublishCanvas'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.PublishCanvas'}}">
            <i class="fas fa-broadcast-tower" aria-hidden="true"></i>
        </button>
    {{/if}}
    <button type="button" data-canvas-action="toggle-audio-mute" data-audio-muted="{{audioMuted}}" title="{{#if audioMuted}}{{localize 'NARRATIVE_CANVAS.Director.UnmuteAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.MuteAudio'}}{{/if}}" aria-label="{{#if audioMuted}}{{localize 'NARRATIVE_CANVAS.Director.UnmuteAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.MuteAudio'}}{{/if}}">
        <i class="fas {{#if audioMuted}}fa-volume-mute{{else}}fa-volume-up{{/if}}" aria-hidden="true"></i>
    </button>
    <button type="button" data-canvas-action="stop-audio" title="{{localize 'NARRATIVE_CANVAS.Director.StopAllAudio'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.StopAllAudio'}}">
        <i class="fas fa-stop" aria-hidden="true"></i>
    </button>
    <button type="button" data-canvas-action="close-handouts" title="{{localize 'NARRATIVE_CANVAS.Labels.CloseAllHandouts'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.CloseAllHandouts'}}">
        <span class="toolbar-composite-icon" aria-hidden="true">
            <i class="fas fa-images"></i>
            <i class="fas fa-times"></i>
        </span>
    </button>
    <button type="button" class="{{#if dialogueSystemEnabled}}is-active{{/if}}" data-canvas-action="toggle-dialogue" aria-pressed="{{#if dialogueSystemEnabled}}true{{else}}false{{/if}}" title="{{localize 'NARRATIVE_CANVAS.Dialogue.Toggle'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Dialogue.Toggle'}}">
        <i class="fas fa-comments" aria-hidden="true"></i>
    </button>
    {{#if characterSheetsFeature}}
    <button type="button" class="{{#if characterSheetsReleased}}is-active{{/if}}" data-canvas-action="toggle-character-sheets" aria-pressed="{{#if characterSheetsReleased}}true{{else}}false{{/if}}" title="{{#if characterSheetsReleased}}{{localize 'NARRATIVE_CANVAS.Director.DisableCharacterSheets'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.EnableCharacterSheets'}}{{/if}}" aria-label="{{#if characterSheetsReleased}}{{localize 'NARRATIVE_CANVAS.Director.DisableCharacterSheets'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.EnableCharacterSheets'}}{{/if}}">
        <i class="fas fa-id-card" aria-hidden="true"></i>
    </button>
    {{/if}}
    <div class="toolbar-theme-menu">
        <button type="button" aria-haspopup="true" title="{{localize 'NARRATIVE_CANVAS.Labels.SelectTheme'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.SelectTheme'}}">
            <i class="fas fa-palette" aria-hidden="true"></i>
        </button>
        <div class="toolbar-theme-options" role="menu">
            {{#each themeOptions}}
                <button type="button" role="menuitemradio" aria-checked="{{selected}}" class="{{#if selected}}is-selected{{/if}}" data-canvas-action="select-theme" data-theme-id="{{id}}">{{label}}</button>
            {{/each}}
        </div>
    </div>
    <button type="button" data-canvas-action="reset-background" title="{{localize 'NARRATIVE_CANVAS.Labels.ResetBackground'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.ResetBackground'}}">
        <i class="fas fa-eraser" aria-hidden="true"></i>
    </button>
    <button type="button" class="is-destructive" data-canvas-action="shutdown" title="{{localize 'NARRATIVE_CANVAS.Labels.ShutdownCanvas'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Labels.ShutdownCanvas'}}">
        <i class="fas fa-power-off" aria-hidden="true"></i>
    </button>
</div>