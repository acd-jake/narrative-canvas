<section class="sidebar-audio-section {{#if isAudioCollapsed}}is-collapsed{{/if}} {{#if audioMuted}}is-muted{{/if}}">
    <header class="director-section-header sidebar-section-header">
        <h4><i class="fas fa-music"></i> {{localize "NARRATIVE_CANVAS.Director.Audio"}}</h4>
        <button type="button" class="sidebar-section-toggle" data-section-toggle="audio" aria-expanded="{{#unless isAudioCollapsed}}true{{else}}false{{/unless}}" aria-controls="director-audio-content" title="{{#if isAudioCollapsed}}{{localize 'NARRATIVE_CANVAS.Director.ExpandAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.CollapseAudio'}}{{/if}}" aria-label="{{#if isAudioCollapsed}}{{localize 'NARRATIVE_CANVAS.Director.ExpandAudio'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.CollapseAudio'}}{{/if}}">
            <i class="fas {{#if isAudioCollapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}" aria-hidden="true"></i>
        </button>
    </header>

    <div class="sidebar-section-content" id="director-audio-content">
        <div class="director-audio-tracks-list">
            {{#each activeSceneAudioEntries}}
                {{#if (eq this.type 'playlist')}}
                    <div class="director-audio-playlist-group {{#if (eq this.playState 'playing')}}is-playing{{else if (eq this.playState 'paused')}}is-paused{{/if}}" data-playlist-id="{{this.playlistId}}">
                        <div class="director-audio-playlist-header">
                            <button type="button" class="btn-scene-playlist-expand type-icon" data-playlist-id="{{this.playlistId}}" aria-expanded="{{#if this.isExpanded}}true{{else}}false{{/if}}" title="{{#if this.isExpanded}}{{localize 'NARRATIVE_CANVAS.Director.CollapsePlaylist'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ExpandPlaylist'}}{{/if}}" aria-label="{{#if this.isExpanded}}{{localize 'NARRATIVE_CANVAS.Director.CollapsePlaylist'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.ExpandPlaylist'}}{{/if}}">
                                <i class="fas {{#if this.isExpanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}" aria-hidden="true"></i>
                            </button>
                            <span class="director-audio-playlist-name" title="{{this.name}}">
                                <i class="fas fa-list-ul" aria-hidden="true"></i> {{this.name}}
                                <span class="playlist-track-count">{{this.tracks.length}}</span>
                            </span>
                            <div class="audio-track-actions">
                                <button type="button" class="btn-scene-playlist-toggle type-icon" data-playlist-id="{{this.playlistId}}" title="{{#if (eq this.playState 'playing')}}{{localize 'NARRATIVE_CANVAS.Director.Pause'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.Play'}}{{/if}}" aria-label="{{#if (eq this.playState 'playing')}}{{localize 'NARRATIVE_CANVAS.Director.Pause'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.Play'}}{{/if}}">
                                    <i class="fas {{#if (eq this.playState 'playing')}}fa-pause{{else}}fa-play{{/if}}" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn-scene-playlist-stop type-icon" data-playlist-id="{{this.playlistId}}" title="{{localize 'NARRATIVE_CANVAS.Director.Stop'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.Stop'}}">
                                    <i class="fas fa-stop" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <div class="director-audio-playlist-contents" {{#unless this.isExpanded}}hidden{{/unless}}>
                            {{#each this.tracks}}
                                <div class="director-audio-track-item is-playlist-track {{#if (eq this.playState 'playing')}}is-playing{{else if (eq this.playState 'paused')}}is-paused{{/if}}" data-track-id="{{this.id}}" data-track-path="{{this.path}}" data-track-name="{{this.name}}">
                                    <div class="audio-track-info">
                                        <span class="audio-track-name" title="{{this.name}}">
                                            <i class="fas fa-volume-up track-status-icon"></i> {{this.name}}
                                        </span>
                                        <div class="audio-track-actions">
                                            <button type="button" class="btn-track-toggle type-icon" title="{{#if (eq this.playState 'playing')}}{{localize 'NARRATIVE_CANVAS.Director.Pause'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.Play'}}{{/if}}" aria-label="{{#if (eq this.playState 'playing')}}{{localize 'NARRATIVE_CANVAS.Director.Pause'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.Play'}}{{/if}}">
                                                <i class="fas {{#if (eq this.playState 'playing')}}fa-pause{{else}}fa-play{{/if}}" aria-hidden="true"></i>
                                            </button>
                                            <button type="button" class="btn-track-stop type-icon" title="{{localize 'NARRATIVE_CANVAS.Director.Stop'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.Stop'}}">
                                                <i class="fas fa-stop" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            {{/each}}
                        </div>
                    </div>
                {{else}}
                    <div class="director-audio-track-item {{#if (eq this.track.playState 'playing')}}is-playing{{else if (eq this.track.playState 'paused')}}is-paused{{/if}}" data-track-id="{{this.track.id}}" data-track-path="{{this.track.path}}" data-track-name="{{this.track.name}}">
                        <div class="audio-track-info">
                            <span class="audio-track-name" title="{{this.track.name}}">
                                <i class="fas fa-volume-up track-status-icon"></i> {{this.track.name}}
                            </span>
                            <div class="audio-track-actions">
                                <button type="button" class="btn-track-toggle type-icon" title="{{#if (eq this.track.playState 'playing')}}{{localize 'NARRATIVE_CANVAS.Director.Pause'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.Play'}}{{/if}}" aria-label="{{#if (eq this.track.playState 'playing')}}{{localize 'NARRATIVE_CANVAS.Director.Pause'}}{{else}}{{localize 'NARRATIVE_CANVAS.Director.Play'}}{{/if}}">
                                    <i class="fas {{#if (eq this.track.playState 'playing')}}fa-pause{{else}}fa-play{{/if}}" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn-track-stop type-icon" title="{{localize 'NARRATIVE_CANVAS.Director.Stop'}}" aria-label="{{localize 'NARRATIVE_CANVAS.Director.Stop'}}">
                                    <i class="fas fa-stop" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                {{/if}}
            {{else}}
                <div class="sidebar-empty-hint">{{localize "NARRATIVE_CANVAS.Director.NoAudioTracks"}}</div>
            {{/each}}
        </div>

        <div class="audio-master-volume-box">
            <div class="audio-now-playing" aria-live="polite" title="{{nowPlayingText}}">{{nowPlayingText}}</div>
            <label class="master-volume-label">
                <i class="fas fa-sliders-h"></i> {{localize "NARRATIVE_CANVAS.Director.MasterVolume"}}
            </label>
            <div class="master-volume-control">
                <i class="fas fa-volume-off"></i>
                <input type="range" class="slider-master-volume" min="0" max="1" step="0.05" value="{{globalVolume}}" />
                <i class="fas fa-volume-up"></i>
                <span class="master-volume-percent">{{masterVolumePercent}}%</span>
            </div>
        </div>
    </div>
</section>